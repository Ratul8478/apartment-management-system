# =======================================================
# FinTrack Pro Enterprise AI Finance Management SaaS
# Complete Master Environment Variable Specification (.env.example)
# =======================================================

# -------------------------------------------------------
# 1. Application Core Configuration
# -------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_ENV="production"
NEXT_PUBLIC_APP_URL="https://fintrackpro.com"
PORT=3000
TZ="UTC"
APP_BASE_CURRENCY="INR"

# -------------------------------------------------------
# 2. Authentication & Session Security
# -------------------------------------------------------
NEXTAUTH_URL="https://fintrackpro.com"
NEXTAUTH_SECRET="generate_secure_random_32char_nextauth_secret"
JWT_SECRET="generate_secure_random_32char_jwt_secret_key"
JWT_EXPIRES_IN="1d"
SESSION_MAX_AGE=86400

# -------------------------------------------------------
# 3. Database Persistence Configuration
# -------------------------------------------------------
DATABASE_URL="postgresql://fintrack_user:fintrack_password@fintrack-db.railway.app:5432/fintrack_db?schema=public&sslmode=require"
DIRECT_URL="postgresql://fintrack_user:fintrack_password@fintrack-db.railway.app:5432/fintrack_db?schema=public&sslmode=require"
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=10000

# -------------------------------------------------------
# 4. Redis Cache & Memory Store
# -------------------------------------------------------
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS_ENABLED=false
REDIS_CACHE_TTL=3600

# -------------------------------------------------------
# 5. Email & Communication Configuration
# -------------------------------------------------------
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASSWORD=""
EMAIL_FROM_ADDRESS="noreply@fintrackpro.com"

# -------------------------------------------------------
# 6. File & Object Storage Configuration
# -------------------------------------------------------
STORAGE_PROVIDER="local"
S3_BUCKET_NAME=""
S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# -------------------------------------------------------
# 7. Grounded AI Provider Configuration
# -------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL_PRIMARY="gemini-1.5-flash"
AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT=30000

# -------------------------------------------------------
# 8. Logging & Observability Configuration
# -------------------------------------------------------
LOG_LEVEL="info"
LOG_FORMAT="json"
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# -------------------------------------------------------
# 9. System Security & Encryption
# -------------------------------------------------------
ENCRYPTION_MASTER_KEY="generate_secure_random_32char_hex_encryption_key"
CORS_ALLOWED_ORIGINS="https://fintrackpro.com"
RATE_LIMIT_MAX_REQUESTS=100

# -------------------------------------------------------
# 10. Background Worker Queue
# -------------------------------------------------------
BULLMQ_WORKER_CONCURRENCY=5
BULLMQ_JOB_MAX_RETRIES=3
BULLMQ_BACKOFF_DELAY=5000

# -------------------------------------------------------
# 11. Enterprise Feature Flags
# -------------------------------------------------------
ENABLE_OCR_INGESTION=true
ENABLE_AI_FORECASTING=true
MAINTENANCE_MODE_ENABLED=false

# -------------------------------------------------------
# 12. Monitoring & Health Diagnostics
# -------------------------------------------------------
HEALTH_CHECK_SECRET=""
METRICS_ENABLED=true
ALERT_WEBHOOK_URL=""

# -------------------------------------------------------
# 13. Production Cloud SaaS Integrations
# -------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="sk_test_placeholder_key"
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"
DEFAULT_AI_PROVIDER="gemini"
GEMINI_API_KEY="AIzaSyYourGoogleGeminiApiKeyHere"
PRIMARY_PAYMENT_GATEWAY="razorpay"
RAZORPAY_KEY_ID="rzp_live_YourRazorpayKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"
STRIPE_SECRET_KEY="sk_live_YourStripeSecretKeyHere"
STRIPE_WEBHOOK_SECRET="whsec_YourStripeWebhookSecretHere"
CLOUDINARY_CLOUD_NAME="fintrack-cloud"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="YourCloudinaryApiSecretHere"
RESEND_API_KEY="re_123456789_YourResendApiKeyHere"
RESEND_FROM_EMAIL="FinTrack Pro <notifications@fintrackpro.com>"
NEXT_PUBLIC_SENTRY_DSN="https://your_sentry_dsn_here@o12345.ingest.sentry.io/6789"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_PROJECT_ID="your_clarity_project_id"

# -------------------------------------------------------
# 14. Firebase Realtime Database Configuration
# -------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

