// -------------------------------------------------------
// 9. Enterprise Billing, Subscriptions, Taxation & Revenue
// -------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  EXPIRED
  INCOMPLETE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentGatewayProvider {
  STRIPE
  RAZORPAY
  PAYPAL
  MANUAL
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  OVERDUE
  VOID
  REFUNDED
}

enum BillingReason {
  SUBSCRIPTION_CYCLE
  PLAN_CHANGE
  USAGE_OVERAGE
  ONE_TIME
}

enum TaxType {
  GST
  VAT
  SALES_TAX
  CUSTOM
}

model SubscriptionPlan {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(50)
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  priceMonthly    Decimal  @default(0) @map("price_monthly") @db.Decimal(18, 2)
  priceYearly     Decimal  @default(0) @map("price_yearly") @db.Decimal(18, 2)
  currency        String   @default("USD") @db.VarChar(3)
  trialPeriodDays Int      @default(14) @map("trial_period_days")
  features        Json     @db.JsonB
  isActive        Boolean  @default(true) @map("is_active")
  isCustom        Boolean  @default(false) @map("is_custom")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp()

  subscriptions Subscription[]
  historyOld    SubscriptionHistory[] @relation("PreviousPlanHistory")
  historyNew    SubscriptionHistory[] @relation("NewPlanHistory")

  @@map("subscription_plans")
}

model Subscription {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                 @unique @map("organization_id") @db.Uuid
  planId                String                 @map("plan_id") @db.Uuid
  status                SubscriptionStatus     @default(TRIALING)
  billingCycle          BillingCycle           @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart    DateTime               @map("current_period_start") @db.Timestamp()
  currentPeriodEnd      DateTime               @map("current_period_end") @db.Timestamp()
  trialStart            DateTime?              @map("trial_start") @db.Timestamp()
  trialEnd              DateTime?              @map("trial_end") @db.Timestamp()
  cancelAtPeriodEnd     Boolean                @default(false) @map("cancel_at_period_end")
  canceledAt            DateTime?              @map("canceled_at") @db.Timestamp()
  endedAt               DateTime?              @map("ended_at") @db.Timestamp()
  paymentGateway        PaymentGatewayProvider @default(STRIPE) @map("payment_gateway")
  gatewayCustomerId     String?                @map("gateway_customer_id") @db.VarChar(100)
  gatewaySubscriptionId String?                @map("gateway_subscription_id") @db.VarChar(100)
  prorationCredits      Decimal                @default(0) @map("proration_credits") @db.Decimal(18, 2)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp()
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamp()

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  history         SubscriptionHistory[]
  billingInvoices BillingInvoice[]
  dunningLogs     DunningLog[]

  @@index([organizationId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  action         String   @db.VarChar(50)
  previousPlanId String?  @map("previous_plan_id") @db.Uuid
  newPlanId      String?  @map("new_plan_id") @db.Uuid
  amountPaid     Decimal  @default(0) @map("amount_paid") @db.Decimal(18, 2)
  proratedAmount Decimal  @default(0) @map("prorated_amount") @db.Decimal(18, 2)
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp()

  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousPlan SubscriptionPlan? @relation("PreviousPlanHistory", fields: [previousPlanId], references: [id], onDelete: SetNull)
  newPlan      SubscriptionPlan? @relation("NewPlanHistory", fields: [newPlanId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([organizationId])
  @@map("subscription_histories")
}

model UsageMeterRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
