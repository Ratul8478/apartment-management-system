// =======================================================
// FinTrack Pro Enterprise AI Finance Management Platform
// Expanded Master Database Schema Specification (Prisma ORM)
// Database Engine: PostgreSQL 16
// =======================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

// -------------------------------------------------------
// Domain Enums
// -------------------------------------------------------

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_MANAGER
  ANALYST
  AUDITOR
}

enum MetricType {
  TURNOVER
  PROFIT_LOSS
  REVENUE
  EXPENSE
  COST
}

enum RecordStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum IngestionSource {
  MANUAL
  CSV_UPLOAD
  OCR_SCAN
  ERP_SYNC
}

enum InvoiceType {
  ACCOUNTS_PAYABLE
  ACCOUNTS_RECEIVABLE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum ReportType {
  POWER_BI_DATASET
  POWERPOINT_PRESENTATION
  FINANCIAL_SUMMARY_PDF
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationType {
  SYSTEM_ALERT
  APPROVAL_REQUEST
  BUDGET_EXCEEDED
  OCR_PROCESSED
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// -------------------------------------------------------
// 1. Enterprise Multi-Tenant, Corporate & Branch Hierarchy
// -------------------------------------------------------

model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(150)
  slug      String    @unique @db.VarChar(100)
  taxId     String?   @map("tax_id") @db.VarChar(50)
  currency  String    @default("INR") @db.VarChar(3)
  timezone  String    @default("UTC") @db.VarChar(50)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt DateTime? @map("deleted_at") @db.Timestamp()

  companies           Company[]
  users               User[]
  accounts            Account[]
  bankAccounts        BankAccount[]
  vendors             Vendor[]
  customers           Customer[]
  financeRecords      FinanceRecord[]
  auditLogs           AuditLog[]
  activityLogs        ActivityLog[]
  subscriptions       Subscription[]
  usageMeters         UsageMeterRecord[]
  billingInvoices     BillingInvoice[]
  paymentMethods      PaymentMethodRecord[]
  paymentTransactions PaymentTransaction[]
  dunningLogs         DunningLog[]
  onboardingProgress  OnboardingProgress[]
  analyticsEvents     ProductAnalyticsEvent[]
  healthScores        CustomerHealthScore[]
  successPlans        CustomerSuccessPlan[]
  crmSyncLogs         CrmSyncLog[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model Company {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(150)
  registrationNo String?      @map("registration_no") @db.VarChar(100)
  country        String       @default("IN") @db.VarChar(2)
  currency       String       @default("INR") @db.VarChar(3)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamp()

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches       Branch[]
  departments    Department[]
  financeRecords FinanceRecord[]
  invoices       Invoice[]

  @@index([organizationId])
  @@index([deletedAt])
  @@map("companies")
}

model Branch {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(100)
  code      String    @unique @db.VarChar(20)
  city      String    @db.VarChar(100)
  state     String?   @db.VarChar(100)
  country   String    @default("IN") @db.VarChar(2)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt DateTime? @map("deleted_at") @db.Timestamp()

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("branches")
}

// -------------------------------------------------------
// 2. Identity, RBAC & Session Security
// -------------------------------------------------------

model User {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String?       @map("organization_id") @db.Uuid
  email               String        @unique @db.VarChar(255)
  passwordHash        String        @map("password_hash") @db.VarChar(255)
  fullName            String        @map("full_name") @db.VarChar(150)
  role                SystemRole    @default(ANALYST)
  isMfaEnabled        Boolean       @default(false) @map("is_mfa_enabled")
  mfaEnabled          Boolean       @default(false) @map("mfa_enabled")
  mfaSecret           String?       @map("mfa_secret") @db.VarChar(255)
  mfaBackupCodes      Json?         @map("mfa_backup_codes") @db.JsonB
  failedLogins        Int           @default(0) @map("failed_logins")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until") @db.Timestamp()
  lockoutUntil        DateTime?     @map("lockout_until") @db.Timestamp()
  isActive            Boolean       @default(true) @map("is_active")
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamp()
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamp()

  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  employee         Employee?
  sessions         Session[]
  userRoles        UserRole[]
  financeRecords   FinanceRecord[]
  reports          Report[]
  aiChatSessions   AiChatSession[]
  aiChatLogs       AiChatLog[]
  notifications    Notification[]
  dashboardWidgets DashboardWidget[]
  auditLogs        AuditLog[]       @relation("ActorAuditLogs")
  actorAuditLogs   AuditLog[]       @relation("ActorUserAuditLogs")
  activityLogs     ActivityLog[]

  @@index([organizationId])
  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  refreshToken String   @unique @map("refresh_token") @db.VarChar(255)
  userAgent    String?  @map("user_agent") @db.Text
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime @map("expires_at") @db.Timestamp()
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp()

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamp()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamp()

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -------------------------------------------------------
// 3. Department, Employee & HR Hierarchy
// -------------------------------------------------------

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  name        String   @db.VarChar(100)
  costCenter  String   @unique @map("cost_center") @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp()

  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  employees      Employee[]
  budgets        Budget[]
  forecasts      Forecast[]
  financialGoals FinancialGoal[]

  @@index([companyId])
  @@map("departments")
}

model Employee {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?   @unique @map("user_id") @db.Uuid
  linkedUserId String?   @map("linked_user_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  department   String?   @db.VarChar(100)
  fullName     String    @map("full_name") @db.VarChar(150)
  designation  String    @db.VarChar(100)
  email        String    @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  salary       Decimal?  @db.Decimal(12, 2)
  managerId    String?   @map("manager_id") @db.Uuid
  dateJoined   DateTime  @default(now()) @map("date_joined") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp()

  linkedUser    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentRef Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager       Employee?   @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates  Employee[]  @relation("ManagerSubordinates")

  @@index([departmentId])
  @@index([designation])
  @@index([deletedAt])
  @@map("employees")
}

// -------------------------------------------------------
// 4. Banking, Accounts, Vendors, Customers & Taxes
// -------------------------------------------------------

model Account {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  accountNumber  String       @unique @map("account_number") @db.VarChar(50)
  name           String       @db.VarChar(100)
  accountType    String       @map("account_type") @db.VarChar(50) // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  currency       String       @default("INR") @db.VarChar(3)
  balance        Decimal      @default(0) @db.Decimal(18, 2)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamp()

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId])
  @@map("accounts")
}

model BankAccount {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  bankName       String       @map("bank_name") @db.VarChar(100)
  accountNumber  String       @unique @map("account_number") @db.VarChar(50)
  ifscSwiftCode  String       @map("ifsc_swift_code") @db.VarChar(20)
  branchName     String?      @map("branch_name") @db.VarChar(100)
  currency       String       @default("INR") @db.VarChar(3)
  currentBalance Decimal      @default(0) @map("current_balance") @db.Decimal(18, 2)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamp()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("bank_accounts")
}

model Vendor {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(150)
  code           String       @unique @db.VarChar(50)
  email          String?      @db.VarChar(255)
  phone          String?      @db.VarChar(30)
  taxId          String?      @map("tax_id") @db.VarChar(50)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamp()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([organizationId])
  @@map("vendors")
}

model Customer {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(150)
  code           String       @unique @db.VarChar(50)
  email          String?      @db.VarChar(255)
  phone          String?      @db.VarChar(30)
  taxId          String?      @map("tax_id") @db.VarChar(50)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamp()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([organizationId])
  @@map("customers")
}

model Tax {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(50) // e.g. GST_18, VAT_20
  rate        Decimal  @db.Decimal(5, 2) // e.g. 18.00%
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()

  invoices Invoice[]

  @@map("taxes")
}

// -------------------------------------------------------
// 5. Invoicing, Payments & Financial Transactions Ledger
// -------------------------------------------------------

model Invoice {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  vendorId      String?     @map("vendor_id") @db.Uuid
  customerId    String?     @map("customer_id") @db.Uuid
  taxId         String?     @map("tax_id") @db.Uuid
  invoiceNumber String      @unique @map("invoice_number") @db.VarChar(50)
  type          InvoiceType @default(ACCOUNTS_PAYABLE)
  amount        Decimal     @db.Decimal(18, 2)
  taxAmount     Decimal     @default(0) @map("tax_amount") @db.Decimal(18, 2)
  status        RecordStatus @default(APPROVED)
  dueDate       DateTime    @map("due_date") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamp()

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tax      Tax?      @relation(fields: [taxId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([companyId])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  accountId     String        @map("account_id") @db.Uuid
  amount        Decimal       @db.Decimal(18, 2)
  paymentDate   DateTime      @map("payment_date") @db.Date
  referenceNo   String        @unique @map("reference_no") @db.VarChar(100)
  status        PaymentStatus @default(COMPLETED)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp()

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique @db.VarChar(100)
  type        MetricType
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp()

  records FinanceRecord[]

  @@map("categories")
}

model FinanceRecord {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?         @map("organization_id") @db.Uuid
  companyId      String?         @map("company_id") @db.Uuid
  recordDate     DateTime        @map("record_date") @db.Date
  metricType     MetricType      @map("metric_type")
  amount         Decimal         @db.Decimal(18, 2)
  currency       String          @default("INR") @db.VarChar(3)
  status         RecordStatus    @default(APPROVED)
  categoryId     String?         @map("category_id") @db.Uuid
  notes          String?         @db.Text
  source         IngestionSource @default(MANUAL)
  createdById    String          @map("created_by_id") @db.Uuid
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp()
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamp()
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamp()

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receipts     Receipt[]

  @@index([organizationId, recordDate, metricType])
  @@index([companyId])
  @@index([recordDate])
  @@index([status])
  @@index([deletedAt])
  @@map("finance_records")
}

// -------------------------------------------------------
// 6. Budgets, Forecasts, Goals, Investments & Liabilities
// -------------------------------------------------------

model Budget {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  fiscalYear   Int      @map("fiscal_year")
  allocated    Decimal  @db.Decimal(18, 2)
  spent        Decimal  @default(0) @db.Decimal(18, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp()

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([departmentId, fiscalYear])
  @@map("budgets")
}

model Forecast {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId   String   @map("department_id") @db.Uuid
  fiscalYear     Int      @map("fiscal_year")
  quarter        Int
  predictedValue Decimal  @map("predicted_value") @db.Decimal(18, 2)
  confidenceLow  Decimal  @map("confidence_low") @db.Decimal(18, 2)
  confidenceHigh Decimal  @map("confidence_high") @db.Decimal(18, 2)
  algorithmUsed  String   @map("algorithm_used") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp()

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId, fiscalYear, quarter])
  @@map("forecasts")
}

model FinancialGoal {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  title        String   @db.VarChar(150)
  targetAmount Decimal  @map("target_amount") @db.Decimal(18, 2)
  targetDate   DateTime @map("target_date") @db.Date
  currentAmount Decimal @default(0) @map("current_amount") @db.Decimal(18, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@map("financial_goals")
}

model Investment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetName     String   @map("asset_name") @db.VarChar(100)
  assetType     String   @map("asset_type") @db.VarChar(50) // EQUITY, BOND, MUTUAL_FUND, REAL_ESTATE
  principal     Decimal  @db.Decimal(18, 2)
  currentMarket Decimal  @map("current_market") @db.Decimal(18, 2)
  purchaseDate  DateTime @map("purchase_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@map("investments")
}

model Loan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lenderName   String   @map("lender_name") @db.VarChar(100)
  principal    Decimal  @db.Decimal(18, 2)
  interestRate Decimal  @map("interest_rate") @db.Decimal(5, 2)
  balance      Decimal  @db.Decimal(18, 2)
  maturityDate DateTime @map("maturity_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@map("loans")
}

// -------------------------------------------------------
// 7. Receipts, OCR, Securities & Grounded AI
// -------------------------------------------------------

model Receipt {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financeRecordId String?        @map("finance_record_id") @db.Uuid
  fileName        String         @map("file_name") @db.VarChar(255)
  fileUrl         String         @map("file_url") @db.Text
  fileSize        Int            @map("file_size")
  mimeType        String         @map("mime_type") @db.VarChar(100)
  uploadedAt      DateTime       @default(now()) @map("uploaded_at") @db.Timestamp()

  financeRecord FinanceRecord? @relation(fields: [financeRecordId], references: [id], onDelete: SetNull)
  ocrResult     OcrResult?

  @@index([financeRecordId])
  @@map("receipts")
}

model OcrResult {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId     String    @unique @map("receipt_id") @db.Uuid
  status        OcrStatus @default(PENDING)
  extractedData Json?     @map("extracted_data") @db.JsonB
  confidence    Decimal?  @db.Decimal(5, 4)
  vendorName    String?   @map("vendor_name") @db.VarChar(150)
  invoiceAmount Decimal?  @map("invoice_amount") @db.Decimal(18, 2)
  invoiceDate   DateTime? @map("invoice_date") @db.Date
  processedAt   DateTime? @map("processed_at") @db.Timestamp()

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("ocr_results")
}

model ShareValue {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticker      String   @default("SELF") @db.VarChar(20)
  recordDate  DateTime @map("record_date") @db.Date
  price       Decimal  @db.Decimal(12, 4)
  currency    String   @default("INR") @db.VarChar(3)
  isPeer      Boolean  @default(false) @map("is_peer")
  companyName String?  @map("company_name") @db.VarChar(100)
  source      String   @default("MANUAL") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@unique([ticker, recordDate])
  @@index([recordDate])
  @@map("share_values")
}

