  @@index([country, state])
  @@map("tax_rules")
}

model BillingInvoice {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber    String        @unique @map("invoice_number") @db.VarChar(50)
  organizationId   String        @map("organization_id") @db.Uuid
  subscriptionId   String?       @map("subscription_id") @db.Uuid
  status           InvoiceStatus @default(DRAFT)
  billingReason    BillingReason @default(SUBSCRIPTION_CYCLE) @map("billing_reason")
  periodStart      DateTime      @map("period_start") @db.Timestamp()
  periodEnd        DateTime      @map("period_end") @db.Timestamp()
  subtotal         Decimal       @db.Decimal(18, 2)
  taxTotal         Decimal       @default(0) @map("tax_total") @db.Decimal(18, 2)
  discountTotal    Decimal       @default(0) @map("discount_total") @db.Decimal(18, 2)
  total            Decimal       @db.Decimal(18, 2)
  amountPaid       Decimal       @default(0) @map("amount_paid") @db.Decimal(18, 2)
  amountRemaining  Decimal       @default(0) @map("amount_remaining") @db.Decimal(18, 2)
  currency         String        @default("USD") @db.VarChar(3)
  gatewayPaymentId String?       @map("gateway_payment_id") @db.VarChar(100)
  pdfUrl           String?       @map("pdf_url") @db.Text
  finalizedAt      DateTime?     @map("finalized_at") @db.Timestamp()
  paidAt           DateTime?     @map("paid_at") @db.Timestamp()
  dueDate          DateTime      @map("due_date") @db.Timestamp()
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamp()
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamp()

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription?            @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  lineItems    BillingInvoiceLineItem[]
  transactions PaymentTransaction[]
  dunningLogs  DunningLog[]

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status])
  @@map("billing_invoices")
}

model BillingInvoiceLineItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String   @db.VarChar(255)
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2)
  proration   Boolean  @default(false)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("billing_invoice_line_items")
}

model PaymentMethodRecord {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                 @map("organization_id") @db.Uuid
  gateway                PaymentGatewayProvider @default(STRIPE)
