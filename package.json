{
  "name": "fintrack-pro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "next lint",
    "config:audit": "node scripts/config-audit.js",
    "config:check": "ts-node -e \"require('./src/lib/config/env')\"",
    "db:platform-check": "npx ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/db-platform-check.ts",
    "db:seed": "npx ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx ts-node -O \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.21.1",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.16.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.453.0",
    "motion": "^12.42.2",
    "next": "14.2.15",
    "next-auth": "^4.24.8",
    "papaparse": "^5.4.1",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@prisma/adapter-pg": "^7.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.14",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg-gateway": "^0.3.0-beta.4",
    "pg-mem": "^3.0.14",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
